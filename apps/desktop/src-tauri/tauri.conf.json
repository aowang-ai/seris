{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seris",
  "version": "0.1.2",
  "identifier": "im.seris.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../core build && pnpm --dir ../desktop-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../.. build",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Seris",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://localhost:5173; object-src 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/core.tar.gz": "core.tar.gz",
      "resources/runtime/": "runtime/",
      "resources/manifest.json": "manifest.json"
    }
  }
}
